{
  "name": "Product Page",
  "path": "/products/:slug",
  "default": {
    "possiblePaths": []
  },
  "sections": [
    {
      "__resolveType": "website/sections/Rendering/Lazy.tsx",
      "section": {
        "__resolveType": "commerce/sections/Seo/SeoPDPV2.tsx",
        "jsonLD": {
          "__resolveType": "PDP Loader"
        },
        "jsonLDs": [
          {}
        ]
      }
    },
    {
      "__resolveType": "website/sections/Rendering/Lazy.tsx",
      "section": {
        "__resolveType": "Header"
      }
    },
    {
      "__resolveType": "website/sections/Rendering/Lazy.tsx",
      "section": {
        "__resolveType": "site/sections/Product/ProductDetails.tsx",
        "page": {
          "__resolveType": "PDP Loader"
        }
      }
    },
    {
      "__resolveType": "website/sections/Rendering/Lazy.tsx",
      "section": {
        "__resolveType": "site/sections/Product/CompleteTheLook.tsx",
        "mostrarProcedencia": true,
        "look": {
          "__resolveType": "site/loaders/completeTheLook.ts"
        }
      }
    },
    {
      "__resolveType": "website/sections/Rendering/Lazy.tsx",
      "section": {
        "__resolveType": "site/sections/Product/ProductShelf.tsx",
        "title": "You may also like",
        "products": {
          "__resolveType": "site/loaders/catalogProductList.ts",
          "count": 9
        }
      }
    },
    {
      "__resolveType": "website/sections/Rendering/Lazy.tsx",
      "section": {
        "__resolveType": "site/sections/Newsletter/Newsletter.tsx"
      }
    },
    {
      "__resolveType": "website/sections/Rendering/Lazy.tsx",
      "section": {
        "__resolveType": "Footer"
      }
    }
  ],
  "__resolveType": "website/pages/Page.tsx"
}
