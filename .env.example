# Copie para `.env` e preencha. É `.env` mesmo — não `.dev.vars`.
#
# Quem carrega: os scripts chamam `process.loadEnvFile(".env")` (Node ≥20.12) e,
# sob o Vite, o `loadEnvPlugin` do TanStack Start — que só olha para o `.env`.
#
# O `.dev.vars` é herança do wrangler, de quando isto rodava em Cloudflare
# Workers. Um único arquivo ainda o consulta, `scripts/shelf-dryrun.ts`, e só
# como preenchimento do que o `.env` não trouxe. Pôr as credenciais lá deixa os
# agentes mudos, com um sintoma idêntico ao de não ter cache quente: a section
# some da home e nada aparece no log.

# ---------------------------------------------------------------------------
# Banco — obrigatório. Sem isto nada sobe.
# ---------------------------------------------------------------------------
# Supabase → Connect → Connection string → Transaction pooler (porta 6543).
# NÃO use a "Direct connection" da 5432.
#
# ATENÇÃO: numa demo em equipe esta costuma ser uma instância COMPARTILHADA.
# `npm run db:reset -- --confirm` apaga o banco inteiro — o de todo mundo.
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Modelo — opcional. Sem estas o site sobe e navega; os agentes é que não compõem.
# ---------------------------------------------------------------------------
STUDIO_BASE_URL=
STUDIO_ORG=
STUDIO_AGENT_ID=
STUDIO_API_KEY=

# ---------------------------------------------------------------------------
# Identidade — opcional, mas necessária para ver a vitrine sem login Shopify.
# ---------------------------------------------------------------------------
# Assina o cookie que identifica quem clicou em "avise-me". Sem o segredo o
# cookie não é emitido nem aceito, e só quem tem sessão Shopify é reconhecido
# pelo agente. Qualquer string longa e aleatória serve.
SHELF_COOKIE_SECRET=
